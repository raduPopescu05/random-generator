{
  "uid": "random-generator-api",
  "title": "API Overview",
  "tags": [
    "random-generator",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape availability",
      "type": "stat",
      "description": "UP means Prometheus can scrape the API; it does not establish database readiness. Unknown means no scrape result.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"random-generator-api\"})",
          "legendFormat": "API",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Request rate",
      "type": "stat",
      "description": "Completed API requests, including grouped unmatched requests. Health, metrics and served static files are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_requests_total{job=\"random-generator-api\"}[$__rate_interval]))) or on() (0 * max(up{job=\"random-generator-api\"}))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "Requests/s",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Server error percentage",
      "type": "stat",
      "description": "No data when there is no traffic; 0% means requests completed without server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * ((sum(rate(http_requests_total{job=\"random-generator-api\",status=~\"5..\"}[$__rate_interval])) or on() (0 * max(up{job=\"random-generator-api\"}))) / (sum(rate(http_requests_total{job=\"random-generator-api\"}[$__rate_interval])) > 0))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "5xx %",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Response latency",
      "type": "timeseries",
      "description": "Histogram estimates of completed HTTP response duration. No data without observations.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"random-generator-api\"}[$__rate_interval]))) and on() (sum(rate(http_request_duration_seconds_count{job=\"random-generator-api\"}[$__rate_interval])) > 0)) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "p50",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"random-generator-api\"}[$__rate_interval]))) and on() (sum(rate(http_request_duration_seconds_count{job=\"random-generator-api\"}[$__rate_interval])) > 0)) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "p95",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Traffic by route",
      "type": "timeseries",
      "description": "Only fixed route labels are recorded. Unrecognized paths share unmatched.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (route) (rate(http_requests_total{job=\"random-generator-api\"}[$__rate_interval]))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "{{route}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Response status distribution",
      "type": "timeseries",
      "description": "Rate by HTTP response status; gaps indicate unavailable data.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (status) (rate(http_requests_total{job=\"random-generator-api\"}[$__rate_interval]))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
