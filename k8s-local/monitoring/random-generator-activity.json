{
  "uid": "random-generator-activity",
  "title": "Generation & Database Activity",
  "tags": [
    "random-generator",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape availability",
      "type": "stat",
      "description": "UP means Prometheus can scrape the API; it does not establish database readiness. Unknown means no scrape result.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"random-generator-api\"})",
          "legendFormat": "API",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Successful generations since process start",
      "type": "stat",
      "description": "Counters reset on restart. This is not the number of rows currently stored in MySQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(generations_total{job=\"random-generator-api\"}) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "{{type}}",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Generation rate",
      "type": "timeseries",
      "description": "Only generations successfully persisted in MySQL are counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (type) (rate(generations_total{job=\"random-generator-api\"}[$__rate_interval]))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "{{type}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Database operation rate",
      "type": "timeseries",
      "description": "API-observed calls, including readiness checks; not MySQL server statistics.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (operation) (rate(database_operations_total{job=\"random-generator-api\"}[$__rate_interval]))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "{{operation}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Database failure rate",
      "type": "timeseries",
      "description": "Failed calls include connection errors. Healthy initialized counters remain zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (operation) (rate(database_operations_total{job=\"random-generator-api\",outcome=\"failure\"}[$__rate_interval]))) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "{{operation}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Database operation p95 latency",
      "type": "timeseries",
      "description": "Includes pool wait and query execution for completed successful and failed operations.",
      "datasource": {
        "type": "prometheus",
        "uid": "random-generator-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le, operation) (rate(database_operation_duration_seconds_bucket{job=\"random-generator-api\"}[$__rate_interval]))) and on(operation) (sum by (operation) (rate(database_operation_duration_seconds_count{job=\"random-generator-api\"}[$__rate_interval])) > 0)) and on() (max(up{job=\"random-generator-api\"}) == 1)",
          "legendFormat": "{{operation}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "random-generator-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
