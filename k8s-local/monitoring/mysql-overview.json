{
  "uid": "random-generator-mysql",
  "title": "MySQL Overview",
  "tags": ["random-generator", "mysql", "provisioned"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "MySQL exporter availability",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "random-generator-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [{ "refId": "A", "expr": "mysql_up", "instant": true, "legendFormat": "MySQL" }],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 2,
      "title": "Connection usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "random-generator-prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "mysql_global_status_threads_connected", "legendFormat": "Connected" },
        { "refId": "B", "expr": "mysql_global_status_max_used_connections", "legendFormat": "Peak used" },
        { "refId": "C", "expr": "mysql_global_variables_max_connections", "legendFormat": "Configured maximum" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 3,
      "title": "Queries per second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "random-generator-prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "rate(mysql_global_status_queries[5m])", "legendFormat": "Queries/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 4,
      "title": "Slow queries per second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "random-generator-prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "rate(mysql_global_status_slow_queries[5m])", "legendFormat": "Slow queries/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 5,
      "title": "InnoDB buffer pool hit ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "random-generator-prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - rate(mysql_global_status_innodb_buffer_pool_reads[5m]) / clamp_min(rate(mysql_global_status_innodb_buffer_pool_read_requests[5m]), 1))", "legendFormat": "Hit ratio" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 6,
      "title": "InnoDB dirty pages",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "random-generator-prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "mysql_global_status_innodb_buffer_pool_pages_dirty", "legendFormat": "Dirty pages" },
        { "refId": "B", "expr": "mysql_global_status_innodb_buffer_pool_pages_total", "legendFormat": "Total pages" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    }
  ]
}
